{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/rbdeforest/baton/schema/baton.schema.json",
  "title": "baton.yaml",
  "description": "Baton lead router configuration. Written by the setup interview (SETUP.md); safe to edit by hand.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "run", "inbox", "reps", "fallback", "webhook"],
  "properties": {
    "version": { "const": 1 },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "every_minutes"],
      "properties": {
        "mode": { "enum": ["laptop"], "description": "Where Baton runs. Only 'laptop' (free, on a timer) exists today." },
        "every_minutes": { "type": "integer", "minimum": 1, "maximum": 1440, "description": "How often the laptop checks the inbox." }
      }
    },
    "inbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "script_url"],
      "properties": {
        "type": { "const": "google_sheet" },
        "script_url": { "type": "string", "pattern": "^https://script\\.google\\.com/", "description": "The Sheet's Apps Script web app URL (ends in /exec)." }
      }
    },
    "reps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "email"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "email": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" },
          "booking_link": { "type": "string", "pattern": "^https?://" },
          "away_until": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Skipped by pools through this date (YYYY-MM-DD)." }
        }
      }
    },
    "pools": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reps", "distribution"],
        "properties": {
          "reps": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "distribution": { "enum": ["even", "weighted"] },
          "weights": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } },
          "daily_cap": { "type": "integer", "minimum": 1, "description": "Most leads one rep gets from this pool per day." }
        }
      }
    },
    "drop": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "personal_email": { "type": "boolean", "description": "Drop gmail.com, yahoo.com and other personal mailboxes." },
        "domains": { "type": "array", "items": { "type": "string" }, "description": "Drop these email domains (and their subdomains), e.g. competitors." },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "when"],
            "properties": { "name": { "type": "string" }, "when": { "$ref": "#/definitions/when" } }
          }
        }
      }
    },
    "routes": {
      "type": "array",
      "description": "Checked top to bottom; the first route whose conditions match wins.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "assign"],
        "properties": {
          "name": { "type": "string" },
          "when": { "$ref": "#/definitions/when" },
          "assign": { "$ref": "#/definitions/target" }
        }
      }
    },
    "fallback": { "$ref": "#/definitions/target" },
    "webhook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": { "url": { "type": "string", "pattern": "^https?://" } }
    }
  },
  "definitions": {
    "target": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["rep"], "properties": { "rep": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["pool"], "properties": { "pool": { "type": "string" } } }
      ]
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field"],
      "minProperties": 2,
      "properties": {
        "field": { "type": "string", "description": "A form field name (case, spaces and underscores ignored), or email_domain." },
        "equals": { "type": ["string", "number", "boolean"] },
        "in": { "type": "array", "items": { "type": ["string", "number", "boolean"] } },
        "contains": { "type": "string" },
        "gte": { "type": "number" },
        "lte": { "type": "number" }
      }
    },
    "when": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "all": { "type": "array", "items": { "$ref": "#/definitions/condition" } },
        "any": { "type": "array", "items": { "$ref": "#/definitions/condition" } }
      }
    }
  }
}
