{
  "name": "baton-router",
  "version": "0.3.0",
  "description": "Open-source lead router. Paste one line into your AI tool, answer a few questions, and route every form lead.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "baton-router": "dist/src/cli/main.js"
  },
  "files": [
    "dist",
    "schema",
    "apps-script",
    "snippet",
    "SETUP.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test 'test/**/*.test.ts'",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rbdeforest/baton.git"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
